section .data
    input: db "%d", 0
    output: db "%d", 0

section .bss
    n: resd 1

section .text
    global main
    extern scanf
    extern printf

main:
    push ebx
    push ecx
	
    push n
    push input
    call scanf
    add esp, 8
    
    mov ebx, [n]
    sub ebx, 543
    
    push ebx
    push output
    call printf
    add esp, 8
    
    pop ecx
    pop ebx
    mov eax, 0
    ret